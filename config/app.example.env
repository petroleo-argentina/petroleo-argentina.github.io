# Application Configuration Example
# Copy to .env or app.env for app server deployment

APP_NAME="Petróleo en Argentina: Del Pozo al País"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Origins (comma separated)
CORS_ORIGINS="*"

# Cache & Static Data Directory
STATIC_DATA_DIR=api/static_data
FRONTEND_DIR=frontend
