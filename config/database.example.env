# Database Configuration Example
# Copy to .env or database.env for remote PostgreSQL/PostGIS deployment

DB_ENGINE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=petroleo_argentina
DB_USER=postgres
DB_PASSWORD=secret_password_change_me

# PostGIS Settings
POSTGIS_ENABLED=true
POSTGIS_SRID=4326

# DuckDB Local Settings
DUCKDB_PATH=data/processed/petroleo.duckdb
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4
